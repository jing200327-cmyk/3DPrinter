%% R001 模型编辑与切片 —— 核心操作流程（主线 A / B / C）
%% 对应 PRD 第四章「核心操作主线」与第六章「业务流程图」
%% 渲染方式：任意支持 Mermaid 的平台（飞书 / Notion / 语雀 / GitHub）直接粘贴本文件内容

flowchart TD
    START(["模型详情页<br/>入口：底部左侧「打印设置」"]) --> EDITOR["模型编辑页<br/>3D 视图 · 分盘切换 · 编辑工具栏"]

    subgraph A["主线 A · 编辑并打印（理想路径）"]
        direction TB
        A1["选中零件<br/>橙色包围框 · 同一时间仅一个"] --> A2["缩放<br/>尺寸 / 百分比 · 等比例 · 实时生效"]
        A2 --> A3["复制<br/>继承尺寸/比例/方向 · 副本默认选中"]
        A3 --> A4["删除<br/>不二次确认 · 取消选中"]
        A4 --> A5["自动摆盘<br/>仅作用于当前盘 · 静默完成"]
        A5 --> A6{"可打印性校验<br/>6 个时机"}
        A6 -- "越界 / 碰撞" --> A7["红色异常态 + 异常盘标记"]
        A7 --> A8["「去打印」置灰<br/>按钮上方显示阻断原因"]
        A6 -- "正常" --> A9["去打印<br/>Loading · 禁止重复提交"]
        A9 --> A10["云切片<br/>合法性校验 → 自动支撑 → 切片<br/>→ 路径计算 → 时间/耗材估算"]
        A10 -- "成功" --> A11(["准备打印页<br/>预计时间 · 耗材 · 盘数量"])
        A10 -- "失败" --> A12["停留编辑页<br/>保留编辑结果 + 具体原因"]
        A12 -.-> A9
    end

    subgraph C["主线 C · 参数调整与持久化"]
        direction TB
        C1["打印设置页 · 6 项参数<br/>打印模式 / 底座 / 喷嘴温度<br/>填充密度 / 支撑开关 / 支撑类型"]
        C1 --> C2["支撑由算法推荐<br/>已根据模型自动推荐"]
        C2 --> C3["恢复默认值<br/>二次确认 · 支撑重新走算法"]
        C3 --> C4{"顶部左侧「退出」<br/>是否有实际修改"}
        C4 -- "无实际修改" --> C8["直接返回模型编辑页"]
        C4 -- "有实际修改" --> C9{"保存范围"}
        C9 -- "仅用于当前模型" --> C5["模型级参数"]
        C9 -- "后续模型默认使用" --> C6["用户默认参数"]
        C9 -- "取消" --> C7["仅当前任务生效<br/>不持久化"]
    end

    subgraph B["主线 B · 多盘任务的编辑"]
        direction TB
        B1["盘号切换<br/>1..8 连续 · 宽度不足可横向滑动"] --> B2["切盘后：3D 只显示该盘零件<br/>清空选中 · 关闭缩放面板"]
        B2 --> B3{"应用至所有盘的零件"}
        B3 -- "关闭（默认）" --> B4["只缩放选中的那一个零件"]
        B3 -- "开启" --> B5["全部打印盘的零件按同一比例一起缩放"]
        B4 --> B6["某盘删除最后一个零件<br/>→ 空盘自动回收 · 盘号前移重编号"]
        B5 --> B6
    end

    EDITOR --> A1
    EDITOR --> C1
    EDITOR --> B1
    A11 --> END(["进入打印流程<br/>准备打印页 → 开始打印"])
    C7 --> A9

    %% ---- 异常与边界 ----
    A2 -. "输入非法 / 超范围" .-> E1["不生效并提示"]
    A3 -. "空间不足" .-> E2["复制失败 · 不新建打印盘"]
    A4 -. "删完全部零件" .-> E3["保留唯一空盘 · 去打印置灰"]
    A9 -. "未选中零件" .-> E4["Toast：请先选择一个零件"]

    classDef main fill:#f5f9ff,stroke:#c7dbfb,stroke-width:1.5px,color:#1d4ed8;
    classDef auto fill:#fffbf2,stroke:#f8dcae,stroke-width:1.5px,color:#b45309;
    classDef cloud fill:#faf7ff,stroke:#ddd0f8,stroke-width:1.5px,color:#6d28d9;
    classDef flow fill:#f3fdfb,stroke:#b6ece4,stroke-width:1.5px,color:#0f766e;
    classDef err fill:#fff6f6,stroke:#f9cdcd,stroke-width:1.5px,color:#b91c1c;

    class A1,A2,A3,A4 main;
    class A5,A6 auto;
    class A9,A10 cloud;
    class A11,A12,C5,C6,C7,B4,B5 flow;
    class A7,A8,E1,E2,E3,E4 err;
    class C1,C2,C3,C4,B1,B2,B3 flow;

import fs from 'node:fs';
let p = fs.readFileSync('R002-模型导入/prd/prd_v1.0.md', 'utf8');
const L = [];
// §5.9 Mermaid 更新（无网直打）
L.push([
`    D["手机系统文件目录（无网模式，仅 gcode）"] --> E{"选择 gcode 文件？"}
    E -- "非 gcode" --> F["锁定不可选 + Toast「无网打印仅支持 gcode 文件」"]
    E -- "是" --> G{"绑定握手（双向）"}
    G -- "两端通过" --> H["无网文件传输页"]
    H --> H2["编辑页点「去打印」<br/>→ 「上传中」进度（非云切片 Loading）"]
    H2 --> H3(["上传完成 → 自动跳转打印页（本期不实现）<br/>弹窗：当前已成功上传模型文件，请联网查看当前打印机状态。"])`,
`    D["手机系统文件目录（无网模式，仅 gcode）<br/>确认按钮 = 「打印」"] --> E{"选择 gcode 文件？"}
    E -- "非 gcode" --> F["锁定不可选 + Toast「无网打印仅支持 gcode 文件」"]
    E -- "是" --> G{"绑定握手（双向）"}
    G -- "两端通过" --> M["点「打印」→「上传中」进度（多文件 i / N）<br/>**不进入模型编辑**（无网不支持云切片 → 不支持编辑，BR-061）"]
    M --> H3(["上传完成弹窗 →「知道了」→ **返回进入无网目录前的页面**<br/>（工作台 / 创意空间 / 编辑页等，从哪来回哪去）<br/>弹窗文案：当前已成功上传模型文件，请联网查看当前打印机状态。"])
    H -. "有网编辑、无网打印的备用链路（BR-037）" .-> H2`]);
// 规则描述：新增无网直打条目
L.push([
`- **触发与连接方式**：用户打开打印机**热点** → APP 进入临时连接通道 → 连上打印机 WiFi 后进入文件传输页。`,
`- **无网直打（BR-061 / DEC-067）**：
  - 无网环境**不支持云切片**，因此也**不支持模型编辑**——无网文件目录的确认按钮为**「打印」**（非「导入」）。
  - 选择 gcode（绑定握手通过）后**直接进入「上传中」进度**（多文件时显示「文件名（i / N）」逐个上传）→「上传完成」提示弹窗。
  - 点「知道了」→ **返回进入无网目录之前所在的页面**（工作台 / 创意空间 / 编辑页等，**从哪来回哪去**）。
  - 校验不通过的文件（如不兼容 gcode）跳过并 Toast 提示未上传数量，不阻断其余文件上传。
- **触发与连接方式**：用户打开打印机**热点** → APP 进入临时连接通道 → 连上打印机 WiFi 后进入文件传输页。`]);
// BR-037 段加备用说明
L.push([
`- **无网「去打印」= 上传中 → 上传完成（BR-037 / DEC-045）**：`,
`- **无网「去打印」= 上传中 → 上传完成（BR-037 / DEC-045）**（**备用链路**：适用于「有网时已编辑好模型、无网点打印」的场景；无网主链路见上方 BR-061 目录直打）：`]);
let n = 0;
for (const [a, b] of L) { if (p.includes(a)) { p = p.replace(a, b); n++; } else console.log('未命中:', a.slice(0, 44).replace(/\n/g, '⏎')); }
p = p.replace(/153 项断言全绿/g, '155 项断言全绿').replace('原型已通过 **153 项**自动化校验', '原型已通过 **155 项**自动化校验');
fs.writeFileSync('R002-模型导入/prd/prd_v1.0.md', p);
console.log('PRD §5.9 更新', n, '/ 3');
let s = fs.readFileSync('_memory/SITEMAP.md', 'utf8');
s = s.replace('**153 项断言全绿**', '**155 项断言全绿**');
fs.writeFileSync('_memory/SITEMAP.md', s);
console.log('SITEMAP 已更新');

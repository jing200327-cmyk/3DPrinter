%% R002 模型导入 · 主链路（v1.1.3：新增 BR-063 混入拦截与 DEC-074 gcode → 切片预览页）
flowchart TD
    A(["创意空间<br/>顶部左侧点「导入模型」"]) --> B["编辑页空态<br/>3D 视图区为空 · 去打印置灰"]
    B --> C["导入选择弹窗<br/>我的 AI 创作 / 我的切片 / 导入本地模型"]

    C --> D{"选择来源"}
    D -- "我的 AI 创作" --> E1["两排多列网格<br/>卡片 = 缩略图 + 名称"]
    D -- "我的切片" --> E2["两排多列网格"]
    D -- "导入本地模型" --> F["手机系统文件目录<br/>模型文件可多选 · gcode / zip 仅可单独导入"]

    E1 -- "点选即导入" --> K
    E2 -- "点选即进入切片预览页（只读）" --> SP["切片预览页（只读 · v1.1）<br/>3D 按已切片层数裁断 + 高度计拖动<br/>底部 G-code 预览：时间 / 耗材 / 尺寸 / 品牌"]
    SP --> SP1["「打印」→ 发送打印 → 工作台"]
    SP --> SP2["回退 → 返回模型编辑页"]

    F --> G0{"文件类型组合校验（BR-063）<br/>多选时混入 gcode / zip？"}
    G0 -- "是（混合）" --> X0["弹窗「无法一起导入」<br/>模型文件与gcode切片文件和zip压缩包不可一起导入<br/>单一主按钮「确定」→ 返回文件目录（勾选保留）"]
    X0 -. "用户调整后重试" .-> F
    G0 -- "否" --> G{"逐文件校验"}

    G -- "格式不在白名单" --> X1["记入失败清单"]
    G -- "三角面超限" --> X1
    G -- "通过" --> I
    G -- "体积超限" --> H{"压缩确认"}
    H -- "取消" --> F
    H -- "自动压缩" --> H1["按文件类型压缩"]
    H1 --> H2{"仍超限？"}
    H2 -- "是" --> X2["记入失败清单"]
    H2 -- "否" --> I

    I --> J{"批量上限"}
    J -- "超出" --> X3["超出部分丢弃"]
    J -- "通过" --> K
    X3 --> K

    K["导入进度<br/>进度条 + 当前文件 + i / N"] -. "上传失败" .-> X5["保留已选清单可重试"]
    K --> K2{"单独上传 gcode？"}
    K2 -- "是" --> SP
    K2 -- "否" --> L{"写入打印盘<br/>追加新盘"}

    L -- "盘数 ≤ 8" --> M
    L -- "已达 8 盘" --> X4["剩余文件丢弃"]
    X4 --> M

    X1 --> R
    X2 --> R
    M --> R{"是否存在未导入项？"}
    R -- "无" --> R0["仅 Toast 提示"]
    R -- "有" --> R1["结果弹窗<br/>失败项在前 · 逐条列原因"]

    R0 --> N
    R1 --> N(["编辑页 · 多盘态<br/>自动分盘 · 每盘独立命名"])
    N --> O["接 R001：编辑 → 打印设置 → 云切片 → 准备打印页"]

    classDef entry fill:#ffe8d9,stroke:#f16326,stroke-width:2px,color:#8a3d10;
    classDef page fill:#eef2ff,stroke:#5f74e8,color:#243b8f;
    classDef warn fill:#fff6e5,stroke:#f59e0b,color:#8a5326;
    classDef deny fill:#ffe9ec,stroke:#e11d48,color:#9b1030;
    classDef readonly fill:#e8f7f4,stroke:#0f766e,color:#0b4f4a;
    class A,N,O entry;
    class B,C,E1,E2,F,K,M,R0,R1 page;
    class D,G0,G,H,H1,H2,I,J,K2,L,R warn;
    class SP,SP1,SP2 readonly;
    class X0,X1,X2,X3,X4,X5 deny;
{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "AI prototype token source. DTCG-shaped tokens mapped to the existing blue-purple IoT Figma system and shadcn semantic names.",
  "$extensions": {
    "sourceOfTruth": "design/blue_purple_iot_design_system/01_Tokens.md",
    "shadcnThemeConvention": "https://ui.shadcn.com/docs/theming"
  },
  "color": {
    "primitive": {
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "black": { "$type": "color", "$value": "#000000" },
      "blue": {
        "50": { "$type": "color", "$value": "#EFF6FF" },
        "600": { "$type": "color", "$value": "#2563EB" },
        "700": { "$type": "color", "$value": "#1D4ED8" }
      },
      "purple": {
        "600": { "$type": "color", "$value": "#7C3AED" }
      },
      "green": {
        "600": { "$type": "color", "$value": "#16A34A" }
      },
      "yellow": {
        "600": { "$type": "color", "$value": "#CA8A04" }
      },
      "neutral": {
        "100": { "$type": "color", "$value": "#F3F4F6" },
        "200": { "$type": "color", "$value": "#E5E7EB" },
        "500": { "$type": "color", "$value": "#6B7280" },
        "900": { "$type": "color", "$value": "#111827" }
      },
      "red": {
        "600": { "$type": "color", "$value": "#DC2626" }
      }
    },
    "semantic": {
      "background": { "$type": "color", "$value": "{color.primitive.white}" },
      "foreground": { "$type": "color", "$value": "{color.primitive.neutral.900}" },
      "card": { "$type": "color", "$value": "{color.primitive.white}" },
      "cardForeground": { "$type": "color", "$value": "{color.semantic.foreground}" },
      "popover": { "$type": "color", "$value": "{color.primitive.white}" },
      "popoverForeground": { "$type": "color", "$value": "{color.semantic.foreground}" },
      "primary": { "$type": "color", "$value": "{brand.primary}" },
      "primaryForeground": { "$type": "color", "$value": "{color.primitive.white}" },
      "secondary": { "$type": "color", "$value": "{color.primitive.blue.50}" },
      "secondaryForeground": { "$type": "color", "$value": "{color.semantic.foreground}" },
      "muted": { "$type": "color", "$value": "{color.primitive.neutral.100}" },
      "mutedForeground": { "$type": "color", "$value": "{color.primitive.neutral.500}" },
      "accent": { "$type": "color", "$value": "{color.primitive.blue.50}" },
      "accentForeground": { "$type": "color", "$value": "{color.semantic.foreground}" },
      "destructive": { "$type": "color", "$value": "{error}" },
      "success": { "$type": "color", "$value": "{success}" },
      "warning": { "$type": "color", "$value": "{warning}" },
      "error": { "$type": "color", "$value": "{error}" },
      "border": { "$type": "color", "$value": "{color.primitive.neutral.200}" },
      "input": { "$type": "color", "$value": "{color.primitive.neutral.200}" },
      "ring": { "$type": "color", "$value": "{color.primitive.blue.600}" },
      "overlay": { "$type": "color", "$value": "#00000080" },
      "brand": {
        "start": { "$type": "color", "$value": "{brand.primary}" },
        "end": { "$type": "color", "$value": "{brand.secondary}" },
        "gradient": {
          "$type": "gradient",
          "$value": [
            { "color": "{color.semantic.brand.start}", "position": 0 },
            { "color": "{color.semantic.brand.end}", "position": 1 }
          ]
        }
      }
    }
  },
  "brand": {
    "primary": { "$type": "color", "$value": "{color.primitive.blue.600}" },
    "secondary": { "$type": "color", "$value": "{color.primitive.purple.600}" }
  },
  "success": { "$type": "color", "$value": "{color.primitive.green.600}" },
  "warning": { "$type": "color", "$value": "{color.primitive.yellow.600}" },
  "error": { "$type": "color", "$value": "{color.primitive.red.600}" },
  "neutral": {
    "surface": { "$type": "color", "$value": "{color.primitive.white}" },
    "foreground": { "$type": "color", "$value": "{color.primitive.neutral.900}" },
    "muted": { "$type": "color", "$value": "{color.primitive.neutral.100}" }
  },
  "space": {
    "4": { "$type": "dimension", "$value": "4px" },
    "8": { "$type": "dimension", "$value": "8px" },
    "12": { "$type": "dimension", "$value": "12px" },
    "16": { "$type": "dimension", "$value": "16px" },
    "24": { "$type": "dimension", "$value": "24px" },
    "32": { "$type": "dimension", "$value": "32px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "16px" }
  },
  "elevation": {
    "level1": {
      "$type": "shadow",
      "$value": { "color": "#00000014", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }
    },
    "level2": {
      "$type": "shadow",
      "$value": { "color": "#0000001F", "offsetX": "0px", "offsetY": "4px", "blur": "8px", "spread": "0px" }
    },
    "level3": {
      "$type": "shadow",
      "$value": { "color": "#00000029", "offsetX": "0px", "offsetY": "12px", "blur": "24px", "spread": "0px" }
    }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": "Inter" },
    "size": {
      "sm": { "$type": "dimension", "$value": "14px" },
      "base": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "20px" },
      "xl": { "$type": "dimension", "$value": "24px" }
    }
  },
  "duration": {
    "fast": { "$type": "duration", "$value": "150ms" },
    "normal": { "$type": "duration", "$value": "200ms" }
  },
  "component": {
    "button": {
      "default": {
        "background": { "$type": "color", "$value": "{color.semantic.primary}" },
        "foreground": { "$type": "color", "$value": "{color.semantic.primaryForeground}" },
        "radius": { "$type": "dimension", "$value": "{radius.md}" },
        "height": { "$type": "dimension", "$value": "40px" }
      },
      "primaryGradient": {
        "start": { "$type": "color", "$value": "{color.semantic.brand.start}" },
        "end": { "$type": "color", "$value": "{color.semantic.brand.end}" },
        "foreground": { "$type": "color", "$value": "{color.primitive.white}" }
      }
    },
    "dialog": {
      "overlay": { "$type": "color", "$value": "{color.semantic.overlay}" },
      "content": {
        "background": { "$type": "color", "$value": "{color.semantic.background}" },
        "foreground": { "$type": "color", "$value": "{color.semantic.foreground}" },
        "border": { "$type": "color", "$value": "{color.semantic.border}" },
        "radius": { "$type": "dimension", "$value": "{radius.lg}" },
        "padding": { "$type": "dimension", "$value": "{space.24}" }
      }
    }
  }
}
